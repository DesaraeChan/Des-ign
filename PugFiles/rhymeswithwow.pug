doctype html
head
  meta(charset='utf-8')
  meta(name='viewport' content='width=device-width, initial-scale=1')
  title RhymesWithWow - Desmond Chen
  link(rel='icon' type='image/x-icon' href='/css/img/icons/MainIcon.ico')
  link(rel='preconnect' href='https://fonts.googleapis.com')
  link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin='')
  script(src='/JavaScript/dropdown.js' defer='')
  script(src='/JavaScript/fadeIn.js' defer='')
  link(href='/css/main.css' rel='stylesheet')
include inc/_navCase
main
  section
    a(href = "https://rhymeswithwow.ca/" target='_blank' rel='noopener noreferrer')
        img.caseImg(alt='RhymesWithWow Frontpage' src='/css/img/RhymesImg/RhymesMain.png' height='600' width='1000')
    .caseContainer
      div
        h1.caseTitle Rhymes With
        h1.caseTitle "Wow" Website
        p.projectCaseSubTitle Contract Work
        
      div
        p.descriptionSubhead Summary
        h2.descriptionHeader
          | A brutalist website design made to show case an author's works
        hr
        .descriptionRoles
          div
            p.roleTitles Role
            p Visual Design, Web Implimentation
          div
            p.roleTitles Tools
            p
              | HTML,
              | CSS, 
              | Figma
          div
            p.roleTitles Duration
            p 4 weeks, Summer 2025
          div
            p.roleTitles Link
            a.websiteDirect(href = "https://rhymeswithwow.ca/" target='_blank' rel='noopener noreferrer') Check it out here
include inc/_footer