doctype html
head
  meta(charset='utf-8')
  meta(name='viewport' content='width=device-width, initial-scale=1')
  title Works - Desmond Chen
  link(rel='icon' type='image/x-icon' href='/css/img/icons/MainIcon.ico')
  link(rel='preconnect' href='https://fonts.googleapis.com')
  link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin='')
  link(href='/css/main.css' rel='stylesheet')
  script(src='/JavaScript/dropdown.js' defer='')
  script(src='/JavaScript/home.js' defer='')
  // <link rel="icon" type="image/x-icon" href="css/imgs/favicon.svg">
include inc/_nav
main
  section
    img.caseImg(alt='Duban Chess Board in use' src='/css/img/DubanImg/DubanHeader.avif' height='600' width='1000')
    .caseContainer
      div
        h1.caseTitle Duban 
        h1.caseTitle Chess Set
        p.projectCaseSubTitle School Project
      div
        p.descriptionSubhead Summary
        h2.descriptionHeader
          | Duban makes chess accessible for the 6 million Canadians with
          | arthritis, preserving elegance and easing play.
        hr
        .descriptionRoles
          div
            p.roleTitles Role
            p 3D Modelling &amp; Rendering, Physical Prototyping, Research &amp; Ideation
          div
            p.roleTitles Tools
            p
              | Solidworks + Visualize,
              | 3D Printing,
              | Laser Cutting
          div
            p.roleTitles Duration
            p 4 weeks, Fall 2024
          div
            p.roleTitles Team
            p Kate Simeonoff (Researcher), Nadine Elkabir (3D Modelling &amp; Rendering) 
include inc/_footer